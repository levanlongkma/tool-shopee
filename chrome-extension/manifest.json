{
  "manifest_version": 3,
  "name": "MimiToys Chrome Helper",
  "version": "1.2.0",
  "description": "Lấy gallery Shopee từ phiên Chrome của bạn và gửi về MimiToys tại localhost:3000.",
  "permissions": ["scripting"],
  "host_permissions": ["https://shopee.vn/*"],
  "background": { "service_worker": "worker.js" },
  "content_scripts": [
    {
      "matches": ["https://shopee.vn/*"],
      "js": ["product-data.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://shopee.vn/*"],
      "js": ["product-network.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://localhost:3000/*", "http://127.0.0.1:3000/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
